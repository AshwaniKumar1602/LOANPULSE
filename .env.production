# ==============================================================================
# LoanPulse Production Environment Configuration (.env.production)
# Target Deployment: Render Free Tier Web Service + Neon PostgreSQL
# ==============================================================================

# Core Application Settings
FLASK_APP=wsgi.py
FLASK_ENV=production
FLASK_DEBUG=0

# Security: High-Entropy Secret Key (min 32 bytes)
# Generate via: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-cryptographically-secure-random-key-in-production

# Neon PostgreSQL Database Connection (SSL Mode strictly required)
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/loanpulse?sslmode=require

# Database Connection Pooling Bounds (Render Free-Tier 512MB RAM Optimization)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=30

# CORS & Domain Origin Whitelist (Disallows permissive wildcards)
# Comma-separated list of trusted frontend origins, e.g., https://loanpulse.onrender.com
CORS_ALLOWED_ORIGINS=https://loanpulse.onrender.com

# Gunicorn Concurrency Settings for Render Free Tier (2 workers x 2 threads)
GUNICORN_WORKERS=2
GUNICORN_THREADS=2

# Session & Cookie Hardening
SESSION_COOKIE_NAME=loanpulse_session
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=7200

# File Upload Security Bounds (5MB max)
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=5242880
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg

# Rate Limiting (Flask-Limiter)
RATELIMIT_DEFAULT=200/day;50/hour
RATELIMIT_STORAGE_URI=memory://

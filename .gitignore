# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment variables & secrets
.env
*.env.local

# Database files (local dev SQLite fallback)
*.sqlite
*.db

# Uploads directory contents (preserve folder structure, ignore uploaded files)
app/static/uploads/*
!app/static/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# IDEs & OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Test & coverage reports
.pytest_cache/
.coverage
htmlcov/

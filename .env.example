# LoanPulse Environment Configuration Template
# DO NOT commit .env with real credentials into version control!

# Flask Core Security Configuration
FLASK_APP=wsgi.py
FLASK_ENV=production
FLASK_DEBUG=0
# Ensure SECRET_KEY is minimum 32 random bytes (e.g. generated via python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-in-production-to-a-cryptographically-secure-key-32-bytes-min

# Neon PostgreSQL Database Connection (SSL required)
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/loanpulse?sslmode=require

# Database Connection Pooling (Render Free Tier Optimization)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=30

# File Upload Security Settings
# Upload directory located outside public web root
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=5242880
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg

# Session & Cookie Security
SESSION_COOKIE_NAME=loanpulse_session
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=3600

# Rate Limiting (Flask-Limiter)
RATELIMIT_DEFAULT=200/day;50/hour
RATELIMIT_STORAGE_URI=memory://

# Server Port
PORT=5000
